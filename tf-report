#!/usr/bin/env bash
set -euo pipefail

CI_MODE=0
OUTPUT_FILE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --ci) CI_MODE=1; shift ;;
        -h|--help)
            echo "Usage: terraform plan | tf-report [--ci] [output.html]"
            echo ""
            echo "Options:"
            echo "  --ci    CI mode: suppress auto-open, cleaner output"
            echo "  -h      Show this help"
            exit 0
            ;;
        -*)
            echo "Unknown option: $1" >&2; exit 1 ;;
        *)
            if [ -z "$OUTPUT_FILE" ]; then
                OUTPUT_FILE="$1"
            else
                echo "Unexpected argument: $1" >&2; exit 1
            fi
            shift ;;
    esac
done

OUTPUT_FILE="${OUTPUT_FILE:-/tmp/tf-report-$(date +%s).html}"
INPUT=$(cat | sed $'s/\033\[[0-9;]*m//g')

if [ -z "$INPUT" ]; then
    echo "Usage: terraform apply | tf-report [output.html]" >&2
    echo "       terraform plan | tf-report [output.html]" >&2
    exit 1
fi

generate_html() {
    local input="$1"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    local summary_line
    summary_line=$(echo "$input" | grep -E '^(Plan:|Apply complete!)' | tail -1 || echo "")

    local add=0 change=0 destroy=0
    if [ -n "$summary_line" ]; then
        add=$(echo "$summary_line" | grep -oE '[0-9]+ (to add|added)' | grep -oE '^[0-9]+' || echo 0)
        change=$(echo "$summary_line" | grep -oE '[0-9]+ (to change|changed)' | grep -oE '^[0-9]+' || echo 0)
        destroy=$(echo "$summary_line" | grep -oE '[0-9]+ (to destroy|destroyed)' | grep -oE '^[0-9]+' || echo 0)
    fi

    cat <<'HTMLHEAD'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Terraform Report</title>
<style>
:root {
    --bg: #1e1e2e;
    --surface: #313244;
    --overlay: #45475a;
    --text: #cdd6f4;
    --subtext: #a6adc8;
    --green: #a6e3a1;
    --red: #f38ba8;
    --yellow: #f9e2af;
    --blue: #89b4fa;
    --mauve: #cba6f7;
    --teal: #94e2d5;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    font-family: 'JetBrains Mono', 'Fira Code', 'SF Mono', monospace;
    background: var(--bg);
    color: var(--text);
    padding: 24px;
    line-height: 1.5;
    font-size: 13px;
}
.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--overlay);
}
.header h1 {
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
}
.header .timestamp {
    color: var(--subtext);
    font-size: 12px;
}
.summary {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
}
.stat {
    padding: 12px 20px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--overlay);
    display: flex;
    align-items: center;
    gap: 10px;
}
.stat .count {
    font-size: 24px;
    font-weight: 700;
}
.stat .label {
    color: var(--subtext);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.stat.add .count { color: var(--green); }
.stat.change .count { color: var(--yellow); }
.stat.destroy .count { color: var(--red); }
.controls {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}
.controls button {
    background: var(--surface);
    border: 1px solid var(--overlay);
    color: var(--text);
    padding: 6px 14px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
    font-family: inherit;
    transition: background 0.15s;
}
.controls button:hover { background: var(--overlay); }
.filter-buttons { display: flex; gap: 6px; margin-left: auto; }
.filter-buttons button { font-size: 11px; padding: 4px 10px; }
.filter-buttons button.active { border-color: var(--blue); color: var(--blue); }
.resource {
    margin-bottom: 8px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--overlay);
    background: var(--surface);
}
.resource.hidden { display: none; }
.resource-header {
    padding: 12px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    user-select: none;
    transition: background 0.15s;
}
.resource-header:hover { background: var(--overlay); }
.resource-header .chevron {
    transition: transform 0.2s;
    color: var(--subtext);
    flex-shrink: 0;
}
.resource.open .resource-header .chevron { transform: rotate(90deg); }
.resource-header .action-badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    flex-shrink: 0;
}
.action-badge.create { background: rgba(166,227,161,0.15); color: var(--green); }
.action-badge.destroy { background: rgba(243,139,168,0.15); color: var(--red); }
.action-badge.update { background: rgba(249,226,175,0.15); color: var(--yellow); }
.action-badge.replace { background: rgba(203,166,247,0.15); color: var(--mauve); }
.action-badge.read { background: rgba(137,180,250,0.15); color: var(--blue); }
.resource-header .resource-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.resource-header .resource-name .module {
    color: var(--subtext);
}
.resource-body {
    display: none;
    padding: 0 16px 16px;
    overflow-x: auto;
}
.resource.open .resource-body { display: block; }
.diff {
    background: var(--bg);
    border-radius: 6px;
    padding: 12px 16px;
    overflow-x: auto;
    font-size: 12px;
    line-height: 1.7;
}
.diff .line { white-space: pre; }
.diff .line.add { color: var(--green); }
.diff .line.remove { color: var(--red); }
.diff .line.change { color: var(--yellow); }
.diff .line.comment { color: var(--subtext); font-style: italic; }
.diff .line.forces { color: var(--mauve); }
.progress-section {
    margin-top: 24px;
    border-top: 1px solid var(--overlay);
    padding-top: 16px;
}
.progress-section h2 {
    font-size: 14px;
    margin-bottom: 12px;
    color: var(--subtext);
}
.progress-item {
    padding: 6px 0;
    font-size: 12px;
}
.progress-item.complete { color: var(--green); }
.progress-item.in-progress { color: var(--yellow); }
.progress-item.error { color: var(--red); }
.search-box {
    padding: 8px 14px;
    background: var(--bg);
    border: 1px solid var(--overlay);
    border-radius: 6px;
    color: var(--text);
    font-size: 12px;
    font-family: inherit;
    width: 260px;
}
.search-box:focus { outline: none; border-color: var(--blue); }
.outputs-section {
    margin-top: 24px;
    border-top: 1px solid var(--overlay);
    padding-top: 16px;
}
.outputs-section h2 {
    font-size: 14px;
    margin-bottom: 12px;
    color: var(--subtext);
}
</style>
</head>
<body>
HTMLHEAD

    cat <<HEADERBLOCK
<div class="header">
    <h1>Terraform Report</h1>
    <span class="timestamp">${timestamp}</span>
</div>
<div class="summary">
    <div class="stat add"><span class="count">${add}</span><span class="label">Add</span></div>
    <div class="stat change"><span class="count">${change}</span><span class="label">Change</span></div>
    <div class="stat destroy"><span class="count">${destroy}</span><span class="label">Destroy</span></div>
</div>
HEADERBLOCK

    cat <<'CONTROLS'
<div class="controls">
    <button onclick="expandAll()">Expand All</button>
    <button onclick="collapseAll()">Collapse All</button>
    <input type="text" class="search-box" placeholder="Filter resources..." oninput="filterResources(this.value)">
    <div class="filter-buttons">
        <button class="active" data-filter="all" onclick="filterByAction('all', this)">All</button>
        <button data-filter="create" onclick="filterByAction('create', this)">+ Add</button>
        <button data-filter="update" onclick="filterByAction('update', this)">~ Change</button>
        <button data-filter="destroy" onclick="filterByAction('destroy', this)">- Destroy</button>
        <button data-filter="replace" onclick="filterByAction('replace', this)">+/- Replace</button>
    </div>
</div>
<div id="resources">
CONTROLS

    echo "$input" | awk '
    BEGIN {
        in_resource = 0
        resource_count = 0
        in_progress = 0
        in_outputs = 0
    }

    /^  # .* will be (created|updated in-place|destroyed|read)/ ||
    /^  # .* must be replaced/ ||
    /^  # .* has moved to/ ||
    /^  # .* will be imported/ {
        if (in_resource) {
            print "___RESOURCE_END___"
        }
        in_resource = 1
        resource_count++
        print "___RESOURCE_START___"
        print $0
        next
    }

    /^Plan:/ || /^Apply complete!/ {
        if (in_resource) {
            print "___RESOURCE_END___"
            in_resource = 0
        }
        next
    }

    /^[a-zA-Z_].*: (Creating|Modifying|Destroying|Reading)\.\.\./ ||
    /^module\..*: (Creating|Modifying|Destroying|Reading)\.\.\./ {
        if (in_resource) {
            print "___RESOURCE_END___"
            in_resource = 0
        }
        if (!in_progress) {
            in_progress = 1
            print "___PROGRESS_START___"
        }
        print $0
        next
    }

    /^[a-zA-Z_].*: (Creation|Modifications|Destruction|Read) complete/ ||
    /^module\..*: (Creation|Modifications|Destruction|Read) complete/ {
        if (!in_progress) {
            in_progress = 1
            print "___PROGRESS_START___"
        }
        print $0
        next
    }

    /^[a-zA-Z_].*: Still (creating|modifying|destroying|reading)/ ||
    /^module\..*: Still (creating|modifying|destroying|reading)/ {
        if (!in_progress) {
            in_progress = 1
            print "___PROGRESS_START___"
        }
        print $0
        next
    }

    /^Outputs:/ {
        if (in_resource) {
            print "___RESOURCE_END___"
            in_resource = 0
        }
        if (in_progress) {
            print "___PROGRESS_END___"
            in_progress = 0
        }
        in_outputs = 1
        print "___OUTPUTS_START___"
        next
    }

    in_resource { print $0 }
    in_progress { print $0 }
    in_outputs { print $0 }

    END {
        if (in_resource) print "___RESOURCE_END___"
        if (in_progress) print "___PROGRESS_END___"
        if (in_outputs) print "___OUTPUTS_END___"
    }
    ' | while IFS= read -r line; do
        case "$line" in
            "___RESOURCE_START___")
                IFS= read -r header_line
                local address action action_class

                address=$(echo "$header_line" | sed 's/^  # //' | sed 's/ will be .*//' | sed 's/ must be .*//' | sed 's/ has moved.*//')

                if echo "$header_line" | grep -q "will be created\|will be imported"; then
                    action="create"
                    action_class="create"
                elif echo "$header_line" | grep -q "will be destroyed"; then
                    action="destroy"
                    action_class="destroy"
                elif echo "$header_line" | grep -q "will be updated"; then
                    action="update"
                    action_class="update"
                elif echo "$header_line" | grep -q "must be replaced"; then
                    action="replace"
                    action_class="replace"
                elif echo "$header_line" | grep -q "will be read"; then
                    action="read"
                    action_class="read"
                elif echo "$header_line" | grep -q "has moved"; then
                    action="update"
                    action_class="update"
                else
                    action="update"
                    action_class="update"
                fi

                local module_part=""
                local name_part="$address"
                if echo "$address" | grep -q "^module\."; then
                    module_part=$(echo "$address" | grep -oE '^(module\.[^.]+\.)+')
                    name_part=$(echo "$address" | sed "s/^${module_part}//")
                fi

                local name_html
                if [ -n "$module_part" ]; then
                    name_html="<span class=\"module\">${module_part}</span>${name_part}"
                else
                    name_html="${name_part}"
                fi

                echo "<div class=\"resource\" data-action=\"${action}\" data-name=\"${address}\">"
                echo "  <div class=\"resource-header\" onclick=\"this.parentElement.classList.toggle('open')\">"
                echo "    <span class=\"chevron\">&#9654;</span>"
                echo "    <span class=\"action-badge ${action_class}\">${action}</span>"
                echo "    <span class=\"resource-name\">${name_html}</span>"
                echo "  </div>"
                echo "  <div class=\"resource-body\"><div class=\"diff\">"
                ;;
            "___RESOURCE_END___")
                echo "</div></div></div>"
                ;;
            "___PROGRESS_START___")
                echo "</div>"
                echo "<div class=\"progress-section\"><h2>Execution Log</h2>"
                ;;
            "___PROGRESS_END___")
                echo "</div>"
                ;;
            "___OUTPUTS_START___")
                echo "<div class=\"outputs-section\"><h2>Outputs</h2><div class=\"diff\">"
                ;;
            "___OUTPUTS_END___")
                echo "</div></div>"
                ;;
            *)
                local escaped
                escaped=$(echo "$line" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')

                local css_class=""
                local stripped
                stripped=$(echo "$line" | sed 's/^[[:space:]]*//')

                if echo "$line" | grep -q "# forces replacement"; then
                    css_class="forces"
                elif echo "$stripped" | grep -qE '^\+'; then
                    css_class="add"
                elif echo "$stripped" | grep -qE '^-'; then
                    css_class="remove"
                elif echo "$stripped" | grep -qE '^~'; then
                    css_class="change"
                elif echo "$stripped" | grep -qE '^#'; then
                    css_class="comment"
                fi

                if echo "$line" | grep -qE ': (Creating|Modifying|Destroying|Reading)\.\.\.'; then
                    echo "<div class=\"progress-item in-progress\">${escaped}</div>"
                elif echo "$line" | grep -qE ': (Creation|Modifications|Destruction|Read) complete'; then
                    echo "<div class=\"progress-item complete\">${escaped}</div>"
                elif echo "$line" | grep -qE ': Still'; then
                    echo "<div class=\"progress-item in-progress\">${escaped}</div>"
                elif [ -n "$css_class" ]; then
                    echo "<div class=\"line ${css_class}\">${escaped}</div>"
                else
                    echo "<div class=\"line\">${escaped}</div>"
                fi
                ;;
        esac
    done

    cat <<'HTMLFOOT'
</div>
<script>
function expandAll() {
    document.querySelectorAll('.resource:not(.hidden)').forEach(el => el.classList.add('open'));
}
function collapseAll() {
    document.querySelectorAll('.resource').forEach(el => el.classList.remove('open'));
}
function filterResources(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('.resource').forEach(el => {
        const name = el.dataset.name.toLowerCase();
        if (name.includes(q)) {
            el.classList.remove('hidden');
        } else {
            el.classList.add('hidden');
        }
    });
}
function filterByAction(action, btn) {
    document.querySelectorAll('.filter-buttons button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.resource').forEach(el => {
        if (action === 'all' || el.dataset.action === action) {
            el.classList.remove('hidden');
        } else {
            el.classList.add('hidden');
        }
    });
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'e' && !e.target.matches('input')) expandAll();
    if (e.key === 'c' && !e.target.matches('input')) collapseAll();
    if (e.key === '/' && !e.target.matches('input')) {
        e.preventDefault();
        document.querySelector('.search-box').focus();
    }
});
</script>
</body>
</html>
HTMLFOOT
}

generate_html "$INPUT" > "$OUTPUT_FILE"

if [ "$CI_MODE" -eq 1 ]; then
    echo "report_path=${OUTPUT_FILE}" >&2
else
    echo "Report generated: ${OUTPUT_FILE}" >&2
    if command -v open &>/dev/null; then
        open "$OUTPUT_FILE"
    elif command -v xdg-open &>/dev/null; then
        xdg-open "$OUTPUT_FILE"
    fi
fi